# OpenAI API key used by the agent.
OPENAI_API_KEY=
# Secret used to sign session cookies. Use at least 32 random characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
# Optional. Defaults to gpt-6-astra.
OPENAI_MODEL=
# Optional. Set to false to stop refunds by the bot; eligible cases go to staff.
BOT_REFUNDS_ENABLED=
# Optional. Most the bot may refund per day across all customers. Defaults to 500.
BOT_DAILY_REFUND_BUDGET=
